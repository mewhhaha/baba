import runtime.intrinsics;

record SourceStep {
  next: u32;
  width: u32;
}

fn utf16_has_trail_unit(input: span<u16>, offset: u32) -> bool {
  if offset + 1 >= span_len(input) {
    return false;
  }
  let lead: u16 = input[offset];
  if lead < (55296 as u16) {
    return false;
  }
  if lead > (56319 as u16) {
    return false;
  }
  let trail: u16 = input[offset + 1];
  if trail < (56320 as u16) {
    return false;
  }
  return trail <= (57343 as u16);
}

fn utf16_code_point_width(input: span<u16>, offset: u32) -> u32 {
  if utf16_has_trail_unit(input, offset) {
    return 2;
  }
  return 1;
}

fn source_next_offset(input: span<u16>, offset: u32) -> u32 {
  return offset + utf16_code_point_width(input, offset);
}

fn source_step(input: span<u16>, offset: u32) -> SourceStep {
  let width: u32 = utf16_code_point_width(input, offset);
  return record SourceStep { next: offset + width, width: width };
}

fn source_text_offset_status(offset: u32, length: u32) -> u32 {
  if offset < length {
    return 0;
  }
  return 1;
}

fn source_text_span_status(start: u32, end: u32, length: u32) -> u32 {
  if end < start {
    return 1;
  }
  if length < end {
    return 2;
  }
  return 0;
}

fn source_text_trail_offset(offset: u32) -> u32 {
  return offset + 1;
}

fn source_text_has_trail_unit(offset: u32, length: u32) -> u32 {
  if source_text_trail_offset(offset) < length {
    return 1;
  }
  return 0;
}
