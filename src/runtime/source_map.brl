import runtime.intrinsics;

record SourceStep {
  next: u32;
  width: u32;
}

fn utf16_has_trail_unit(input: span<u16>, offset: u32) -> bool {
  if offset + 1 >= span_len(input) {
    return false;
  }
  let lead: u16 = input[offset];
  if lead < (55296 as u16) {
    return false;
  }
  return lead <= (56319 as u16);
}

fn utf16_code_point_width(input: span<u16>, offset: u32) -> u32 {
  if utf16_has_trail_unit(input, offset) {
    return 2;
  }
  return 1;
}

fn source_next_offset(input: span<u16>, offset: u32) -> u32 {
  return offset + utf16_code_point_width(input, offset);
}

fn source_step(input: span<u16>, offset: u32) -> SourceStep {
  let width: u32 = utf16_code_point_width(input, offset);
  return record SourceStep { next: offset + width, width: width };
}
