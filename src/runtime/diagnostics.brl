fn diagnostic_code_is_lexical(code: u32) -> bool {
  return code < 1000;
}

fn diagnostic_span_is_valid(source_length: u32, start: u32, end: u32) -> bool {
  if start > end {
    return false;
  }
  return end <= source_length;
}

fn diagnostic_merge_count(left: u32, right: u32) -> u32 {
  return left + right;
}

fn diagnostic_detail_kind_id(code: u32) -> u32 {
  if code == 1001 {
    return 1;
  }
  if code == 1002 {
    return 1;
  }
  return 0;
}

fn diagnostic_code_status(actual: u32, expected: u32) -> u32 {
  if actual == expected {
    return 0;
  }
  return 1;
}

fn diagnostic_merge_status(left_count: u32, right_count: u32) -> u32 {
  if (left_count == 0) && (right_count == 0) {
    return 0;
  }
  if left_count == 0 {
    return 2;
  }
  if right_count == 0 {
    return 1;
  }
  return 3;
}
