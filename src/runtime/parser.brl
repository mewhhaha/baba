fn parser_action_kind(action: u32) -> u32 {
  return (action / 16777216) * 16777216;
}

fn parser_action_payload(action: u32) -> u32 {
  return action - parser_action_kind(action);
}

fn parser_is_accept(action: u32) -> bool {
  return parser_action_kind(action) == 50331648;
}

fn parser_replay_action_status(action_kind: u32) -> u32 {
  if action_kind == 16777216 {
    return 1;
  }
  if action_kind == 33554432 {
    return 2;
  }
  if action_kind == 50331648 {
    return 3;
  }
  return 0;
}

fn parser_trace_status_kind(status: u32) -> u32 {
  if status == 0 {
    return 0;
  }
  if status == 1 {
    return 1;
  }
  if status == 2 {
    return 2;
  }
  if status == 3 {
    return 3;
  }
  if status == 4 {
    return 4;
  }
  if status == 5 {
    return 5;
  }
  return 2;
}

fn parser_action_count(actions: span<u32>, start: u32) -> u32 {
  let count: u32 = 0;
  while actions[start + count] != 0 {
    count = count + 1;
  }
  return count;
}

fn parser_table_lookup(
  rows: span<u32>,
  entries: span<u32>,
  state: u32,
  key: u32,
  missing: u32,
) -> u32 {
  let low: u32 = rows[state];
  let high: u32 = rows[state + 1];
  while low < high {
    let midpoint: u32 = (low + high) / 2;
    let index: u32 = midpoint * 2;
    let entry_key: u32 = entries[index];
    if key < entry_key {
      high = midpoint;
    } else {
      if entry_key < key {
        low = midpoint + 1;
      } else {
        return entries[index + 1];
      }
    }
  }
  return missing;
}

fn parser_table_lookup_at(
  rows: span<u32>,
  entries: span<u32>,
  state: u32,
  key: u32,
  ordinal: u32,
  missing: u32,
) -> u32 {
  let index: u32 = rows[state];
  let row_end: u32 = rows[state + 1];
  let result: u32 = missing;
  let seen: u32 = 0;
  while index < row_end {
    let entry_index: u32 = index * 2;
    let entry_key: u32 = entries[entry_index];
    if entry_key == key {
      if seen == ordinal {
        result = entries[entry_index + 1];
        index = row_end;
      }
      if seen != ordinal {
        seen = seen + 1;
        index = index + 1;
      }
    }
    if entry_key != key {
      index = index + 1;
    }
  }
  return result;
}

fn parser_expected_start(rows: span<u32>, row_count: u32, state: u32) -> u32 {
  if state < row_count {
    return rows[state];
  }
  return 0;
}

fn parser_expected_end(rows: span<u32>, row_count: u32, state: u32) -> u32 {
  if state < row_count {
    return rows[state + 1];
  }
  return 0;
}

fn parser_expected_has_eof(flags: span<u32>, row_count: u32, state: u32) -> u32 {
  if state < row_count {
    return flags[state];
  }
  return 0;
}

fn parser_expected_row_status(start: u32, end: u32) -> u32 {
  if start < end {
    return 1;
  }
  return 0;
}

fn parser_unexpected_diagnostic_code(expected_has_eof: u32, is_eof: u32) -> u32 {
  if (expected_has_eof != 0) && (is_eof == 0) {
    return 3;
  }
  return 2;
}

fn parser_production_load(
  productions: span<u32>,
  production_count: u32,
  production: u32,
  field_offset: u32,
) -> u32 {
  if production < production_count {
    return productions[(production * 2) + field_offset];
  }
  return 4294967295;
}

fn parser_runtime_value_status(is_null: u32, object_kind: u32) -> u32 {
  if is_null == 1 {
    return 0;
  }
  if object_kind == 7 {
    return 1;
  }
  if object_kind == 6 {
    return 2;
  }
  if object_kind == 3 {
    return 3;
  }
  if object_kind == 4 {
    return 4;
  }
  return 5;
}

fn parser_accepted_root_status(
  is_rule_node: u32,
  is_fragment: u32,
  fragment_value_is_rule_node: u32,
) -> u32 {
  if is_rule_node == 1 {
    return 1;
  }
  if (is_fragment == 1) && (fragment_value_is_rule_node == 1) {
    return 2;
  }
  return 0;
}

fn parser_span_merge_start(
  left_start: u32,
  left_end: u32,
  right_start: u32,
  right_end: u32,
) -> u32 {
  if left_start == 4294967295 {
    return right_start;
  }
  if right_start == 4294967295 {
    return left_start;
  }
  if left_start < right_start {
    return left_start;
  }
  return right_start;
}

fn parser_span_merge_end(
  left_start: u32,
  left_end: u32,
  right_start: u32,
  right_end: u32,
) -> u32 {
  if left_start == 4294967295 {
    return right_end;
  }
  if right_start == 4294967295 {
    return left_end;
  }
  if left_end < right_end {
    return right_end;
  }
  return left_end;
}
