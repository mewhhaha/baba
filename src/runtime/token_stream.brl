fn token_span_is_ordered(start: u32, end: u32) -> bool {
  return start <= end;
}

fn token_stream_gap_is_empty(previous_end: u32, next_start: u32) -> bool {
  return previous_end == next_start;
}

fn token_stream_can_advance(previous_end: u32, next_start: u32) -> bool {
  return previous_end <= next_start;
}

fn token_stream_span_bounds_status(start: u32, end: u32, source_length: u32) -> u32 {
  if source_length < end {
    return 1;
  }
  if end < start {
    return 1;
  }
  return 0;
}

fn token_stream_span_position_status(start: u32, previous_end: u32) -> u32 {
  if previous_end < start {
    return 2;
  }
  if start < previous_end {
    return 3;
  }
  return 0;
}

fn token_stream_width_status(start: u32, end: u32) -> u32 {
  if start == end {
    return 4;
  }
  return 0;
}

fn token_stream_eof_status(
  text_length: u32,
  is_main_channel: u32,
  start: u32,
  end: u32,
  source_length: u32,
) -> u32 {
  if text_length != 0 {
    return 5;
  }
  if is_main_channel != 1 {
    return 5;
  }
  if start != end {
    return 5;
  }
  if start != source_length {
    return 5;
  }
  return 0;
}

fn token_stream_eof_sequence_status(has_eof: u32) -> u32 {
  if has_eof == 1 {
    return 5;
  }
  return 0;
}

fn token_stream_gap_token_status(
  token_class: u32,
  token_start: u32,
  token_end: u32,
  gap_start: u32,
  gap_end: u32,
) -> u32 {
  if token_class != 3 {
    return 6;
  }
  if token_start < gap_start {
    return 6;
  }
  if gap_end < token_end {
    return 6;
  }
  return 0;
}

fn token_stream_token_match_status(
  left_class: u32,
  right_class: u32,
  left_spec_index: u32,
  right_spec_index: u32,
  left_terminal: u32,
  right_terminal: u32,
  left_start: u32,
  left_end: u32,
  right_start: u32,
  right_end: u32,
) -> u32 {
  if left_class != right_class {
    return 7;
  }
  if left_spec_index != right_spec_index {
    return 7;
  }
  if left_terminal != right_terminal {
    return 7;
  }
  if left_start != right_start {
    return 7;
  }
  if left_end != right_end {
    return 7;
  }
  return 0;
}

fn token_stream_trace_status(token_class: u32) -> u32 {
  if token_class == 3 {
    return 1;
  }
  return 0;
}

fn token_stream_canonical_match_status(
  canonical_class: u32,
  token_match_status: u32,
  canonical_end: u32,
  supplied_start: u32,
) -> u32 {
  if token_match_status == 0 {
    return 0;
  }
  if token_stream_trace_status(canonical_class) != 1 {
    return 2;
  }
  if supplied_start < canonical_end {
    return 2;
  }
  return 1;
}

fn token_stream_final_status(
  has_eof: u32,
  eof_index: u32,
  token_count: u32,
  previous_end: u32,
  source_length: u32,
) -> u32 {
  if (has_eof == 1) && (eof_index + 1 != token_count) {
    return 5;
  }
  if has_eof == 1 {
    return 0;
  }
  if previous_end < source_length {
    return 2;
  }
  return 0;
}

fn token_stream_public_token_shape_status(
  token_type: u32,
  channel: u32,
  literal_text_matches: u32,
) -> u32 {
  if (token_type == 1) && (channel != 1) {
    return 1;
  }
  if (token_type == 1) && (literal_text_matches == 1) {
    return 0;
  }
  if token_type == 1 {
    return 1;
  }
  if (token_type == 2) && (channel == 1) {
    return 0;
  }
  if (token_type == 2) && (channel == 2) {
    return 0;
  }
  if token_type == 2 {
    return 2;
  }
  if (token_type == 3) && (channel == 3) {
    return 0;
  }
  if token_type == 3 {
    return 3;
  }
  if token_type == 4 {
    return 0;
  }
  return 4;
}

fn token_stream_trace_stream_status(public_class: u32) -> u32 {
  if public_class == 3 {
    return 1;
  }
  if public_class == 5 {
    return 2;
  }
  return 0;
}

fn token_stream_public_index(index: u32, token_count: u32) -> u32 {
  if index < token_count {
    return index;
  }
  return token_count;
}

fn token_stream_trace_terminal(
  public_class: u32,
  trusted_terminal: u32,
  spec_terminal: u32,
  eof_terminal: u32,
) -> u32 {
  if public_class == 5 {
    return eof_terminal;
  }
  if trusted_terminal != 4294967295 {
    return trusted_terminal;
  }
  return spec_terminal;
}

fn token_stream_shifted_token_status(public_class: u32) -> u32 {
  if public_class == 1 {
    return 0;
  }
  if public_class == 2 {
    return 0;
  }
  return 1;
}

fn token_stream_trace_step(
  public_class: u32,
  trusted_terminal: u32,
  spec_terminal: u32,
  eof_terminal: u32,
) -> u32 {
  let status: u32 = token_stream_trace_stream_status(public_class);
  let terminal: u32 = token_stream_trace_terminal(
    public_class,
    trusted_terminal,
    spec_terminal,
    eof_terminal,
  );
  if terminal == 4294967295 {
    terminal = 16777215;
  }
  return (status * 16777216) + terminal;
}

fn token_stream_trace_step_status(step: u32) -> u32 {
  return step / 16777216;
}

fn token_stream_trace_step_terminal(step: u32) -> u32 {
  let terminal: u32 = step - ((step / 16777216) * 16777216);
  if terminal == 16777215 {
    return 4294967295;
  }
  return terminal;
}
