fn reducer_operation(kind: u32) -> u32 {
  if kind == 1 {
    return 1;
  }
  if kind == 2 {
    return 2;
  }
  if kind == 3 {
    return 3;
  }
  if kind == 4 {
    return 4;
  }
  if kind == 5 {
    return 5;
  }
  if kind == 8 {
    return 5;
  }
  if kind == 6 {
    return 6;
  }
  if kind == 7 {
    return 7;
  }
  if kind == 9 {
    return 8;
  }
  if kind == 10 {
    return 9;
  }
  if kind == 12 {
    return 9;
  }
  if kind == 11 {
    return 10;
  }
  if kind == 13 {
    return 10;
  }
  if kind == 14 {
    return 11;
  }
  if kind == 15 {
    return 12;
  }
  return 0;
}

fn reducer_payload_status(operation: u32, payload: u32) -> u32 {
  if payload != 4294967295 {
    return 0;
  }
  if operation == 2 {
    return 2;
  }
  if operation == 12 {
    return 3;
  }
  return 0;
}

fn reducer_load(
  reducers: span<u32>,
  reducer_count: u32,
  production: u32,
  field_offset: u32,
  missing: u32,
) -> u32 {
  if production < reducer_count {
    return reducers[(production * 2) + field_offset];
  }
  return missing;
}

fn reducer_child_role(operation: u32, slot: u32) -> u32 {
  if (operation == 1) && (slot == 0) {
    return 1;
  }
  if (operation == 2) && (slot == 0) {
    return 2;
  }
  if (operation == 3) && (slot == 0) {
    return 3;
  }
  if (operation == 4) && (slot == 0) {
    return 4;
  }
  if (operation == 5) && (slot == 0) {
    return 2;
  }
  if operation == 6 {
    return 2;
  }
  if (operation == 9) && (slot == 0) {
    return 2;
  }
  if (operation == 9) && (slot == 1) {
    return 2;
  }
  if (operation == 10) && (slot == 0) {
    return 2;
  }
  if (operation == 11) && (slot == 0) {
    return 2;
  }
  if (operation == 11) && (slot == 1) {
    return 2;
  }
  if (operation == 11) && (slot == 2) {
    return 2;
  }
  if (operation == 12) && (slot == 0) {
    return 2;
  }
  return 0;
}

fn reducer_result_kind(operation: u32) -> u32 {
  if operation == 1 {
    return 1;
  }
  if operation == 2 {
    return 2;
  }
  if operation == 3 {
    return 3;
  }
  if operation == 4 {
    return 3;
  }
  if operation == 5 {
    return 3;
  }
  if operation == 6 {
    return 4;
  }
  if operation == 7 {
    return 5;
  }
  if operation == 8 {
    return 6;
  }
  if operation == 9 {
    return 7;
  }
  if operation == 10 {
    return 8;
  }
  if operation == 11 {
    return 9;
  }
  if operation == 12 {
    return 10;
  }
  return 0;
}

fn reducer_replay_status(
  rhs_length: u32,
  operation: u32,
  payload_status: u32,
  value_depth: u32,
) -> u32 {
  if rhs_length == 4294967295 {
    return 1;
  }
  if operation == 0 {
    return 1;
  }
  if payload_status == 1 {
    return 1;
  }
  if payload_status == 2 {
    return 2;
  }
  if payload_status == 3 {
    return 3;
  }
  if value_depth < rhs_length {
    return 4;
  }
  return 0;
}

fn reducer_replay_rhs_start(value_count: u32, rhs_length: u32) -> u32 {
  return value_count - rhs_length;
}

fn reducer_replay_stack_depth(value_count: u32) -> u32 {
  if value_count == 0 {
    return 0;
  }
  return value_count - 1;
}
