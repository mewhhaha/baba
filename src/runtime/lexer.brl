import runtime.intrinsics;

fn lexer_is_upper_ascii_letter(unit: u16) -> bool {
  if unit < (65 as u16) {
    return false;
  }
  return unit <= (90 as u16);
}

fn lexer_is_lower_ascii_letter(unit: u16) -> bool {
  if unit >= (97 as u16) {
    return unit <= (122 as u16);
  }
  return false;
}

fn lexer_is_ascii_letter(unit: u16) -> bool {
  if lexer_is_upper_ascii_letter(unit) {
    return true;
  }
  return lexer_is_lower_ascii_letter(unit);
}

fn lexer_scan_identifier(input: span<u16>, start: u32) -> u32 {
  let offset: u32 = start;
  while offset < span_len(input) {
    if lexer_is_ascii_letter(input[offset]) == false {
      break;
    }
    offset = offset + 1;
  }
  return offset;
}

fn lexer_has_match(input: span<u16>, start: u32) -> bool {
  return lexer_scan_identifier(input, start) > start;
}

fn lexer_dfa_transition(
  rows: span<u32>,
  values: span<u32>,
  state: u32,
  code_point: u32,
) -> u32 {
  let low: u32 = rows[state];
  let high: u32 = rows[state + 1];
  while low < high {
    let midpoint: u32 = (low + high) / 2;
    let index: u32 = midpoint * 3;
    let start: u32 = values[index];
    if code_point < start {
      high = midpoint;
    } else {
      let end: u32 = values[index + 1];
      if end < code_point {
        low = midpoint + 1;
      } else {
        return values[index + 2];
      }
    }
  }
  return 4294967295;
}

fn lexer_token_emit_status(token_class: u32, preserve_trivia: u32) -> u32 {
  if (token_class == 2) && (preserve_trivia == 0) {
    return 0;
  }
  return 1;
}

fn lexer_spec_token_class(flags: u32) -> u32 {
  if (flags % 2) != 0 {
    return 1;
  }
  if ((flags / 2) % 2) != 0 {
    return 2;
  }
  return 3;
}

fn lexer_spec_public_token_status(spec_class: u32, public_class: u32) -> u32 {
  if spec_class == 0 {
    return 1;
  }
  if (public_class == 1) && (spec_class == 1) {
    return 0;
  }
  if public_class == 1 {
    return 2;
  }
  if (public_class == 2) && (spec_class == 3) {
    return 0;
  }
  if public_class == 2 {
    return 3;
  }
  if (public_class == 3) && (spec_class == 2) {
    return 0;
  }
  if public_class == 3 {
    return 4;
  }
  return 1;
}

fn lexer_public_token_class(token_class: u32) -> u32 {
  if token_class == 1 {
    return 1;
  }
  if token_class == 2 {
    return 3;
  }
  return 2;
}

fn lexer_token_diagnostic_status(public_class: u32, terminal: u32) -> u32 {
  if public_class == 4 {
    return 1;
  }
  if public_class == 3 {
    return 0;
  }
  if public_class == 5 {
    return 0;
  }
  if (public_class == 1) && (terminal == 4294967295) {
    return 2;
  }
  if public_class == 1 {
    return 0;
  }
  if (public_class == 2) && (terminal == 4294967295) {
    return 2;
  }
  if public_class == 2 {
    return 0;
  }
  return 2;
}

fn lexer_driver_begin_event(offset: u32, source_length: u32) -> u32 {
  if offset < source_length {
    return 1;
  }
  return 0;
}

fn lexer_driver_finalize_event(
  spec_index: u32,
  token_class: u32,
  preserve_trivia: u32,
  token_end: u32,
  source_length: u32,
) -> u32 {
  if spec_index == 4294967295 {
    return 3;
  }
  if lexer_token_emit_status(token_class, preserve_trivia) == 1 {
    return 2;
  }
  return lexer_driver_begin_event(token_end, source_length);
}

fn lexer_driver_consume_event(
  current_event: u32,
  token_end: u32,
  source_length: u32,
) -> u32 {
  if current_event == 0 {
    return 0;
  }
  if current_event == 1 {
    return 4294967295;
  }
  return lexer_driver_begin_event(token_end, source_length);
}
