{
  "name": "@mewhhaha/baba",
  "version": "1.6.0",
  "license": "MIT",
  "exports": {
    ".": "./src/mod.ts",
    "./advanced": "./src/advanced.ts",
    "./kit": "./src/kit.ts",
    "./cli": "./src/cli.ts"
  },
  "publish": {
    "include": [
      "README.md",
      "CHANGELOG.md",
      "LICENSE",
      "deno.json",
      "size-budgets.json",
      "docs/**/*.md",
      "scripts/**/*.ts",
      "src/**/*.ts",
      "examples/README.md",
      "examples/*/README.md",
      "examples/*/deno.json",
      "examples/*/grammar.ebnf",
      "examples/*/baba.json",
      "examples/*/programs/**/*",
      "examples/*/interpreter.ts",
      "examples/*/parser_kit_consumer.ts",
      "examples/*/aot.ts",
      "examples/*/bench.ts"
    ]
  },
  "fmt": {
    "exclude": [
      "examples/brainfuck/generated",
      "examples/feature-tour/generated",
      "examples/funcfuck/generated",
      "examples/thunkwasm/generated",
      "src/runtime_language/SPEC.md",
      "tasks"
    ]
  },
  "lint": {
    "include": [
      "src",
      "scripts"
    ]
  },
  "tasks": {
    "bootstrap": "deno run --allow-read --allow-write scripts/bootstrap_check.ts --write",
    "bootstrap:check": "deno run --allow-read --allow-write scripts/bootstrap_check.ts",
    "test": "deno test --allow-read --allow-write --allow-run",
    "test:brl-conformance": "deno test --allow-read --allow-write --allow-run tests/runtime_language_conformance_test.ts tests/runtime_language_frontend_test.ts tests/runtime_language_wasm_test.ts",
    "test:fuzz": "deno test --allow-read --allow-write --allow-run tests/fuzz_test.ts",
    "test:parity": "deno test --allow-read --allow-write --allow-run tests/ts_wasm_parity_test.ts",
    "test:portable": "deno test --allow-read --allow-write --allow-run tests/portable_fixture_test.ts tests/portable_plan_test.ts",
    "test:runtime-smoke": "deno run --allow-read --allow-write --allow-run tests/runtime_smoke.ts deno node bun",
    "test:tree-sitter": "deno test --allow-read --allow-write --allow-run tests/tree_sitter_test.ts",
    "check": "deno check src/mod.ts src/advanced.ts src/cli.ts scripts/*.ts bench/*.ts tests/*.ts",
    "bench": "deno run --allow-read --allow-write bench/ts_vs_wasm.ts",
    "bench:wasm": "deno run --allow-read --allow-write bench/ts_vs_wasm.ts",
    "size:report": "deno run --allow-read --allow-write scripts/size_report.ts",
    "size:check": "deno run --allow-read scripts/size_report.ts --budget size-budgets.json",
    "publish:dry-run": "deno publish --dry-run --allow-dirty"
  }
}
