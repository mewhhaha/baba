{
  "name": "@mewhhaha/baba",
  "version": "2.0.1",
  "license": "MIT",
  "exports": {
    ".": "./src/mod.ts",
    "./cli": "./src/cli.ts",
    "./runtime": "./src/runtime/mod.ts",
    "./runtime/wasm": "./src/runtime/wasm.ts"
  },
  "publish": {
    "include": [
      "README.md",
      "CHANGELOG.md",
      "LICENSE",
      "deno.json",
      "docs/wasm.md",
      "docs/wasm-abi.md",
      "src/api.ts",
      "src/ast.ts",
      "src/bundle.ts",
      "src/cli.ts",
      "src/compiler/analyze.ts",
      "src/compiler/diagnostics.ts",
      "src/compiler/ir.ts",
      "src/compiler/portable_plan/adapters.ts",
      "src/compiler/regex/ast.ts",
      "src/compiler/regex/dfa.ts",
      "src/compiler/regex/diagnostics.ts",
      "src/compiler/regex/intersect.ts",
      "src/compiler/regex/lexer.ts",
      "src/compiler/regex/limits.ts",
      "src/compiler/regex/nfa.ts",
      "src/compiler/regex/nullable.ts",
      "src/compiler/regex/overlap.ts",
      "src/compiler/regex/parser.ts",
      "src/errors.ts",
      "src/metadata.ts",
      "src/mod.ts",
      "src/output.ts",
      "src/parser.ts",
      "src/runtime/compact_plan_binary.ts",
      "src/runtime/mod.ts",
      "src/runtime/wasm.ts",
      "src/runtime/wasm_executor.ts",
      "src/runtime/wasm_plan.ts",
      "src/runtime/parser_plan.ts",
      "src/runtime_language/backends/wasm/encode.ts",
      "src/runtime_language/backends/wasm/verify.ts",
      "src/runtime_language/backends/wasm/wasm_ir.ts",
      "src/targets/runtime/diagnostic_codes.ts",
      "src/targets/runtime/field_schema.ts",
      "src/targets/runtime/implementation.ts",
      "src/targets/runtime/language.ts",
      "src/targets/runtime/language_sources.ts",
      "src/targets/runtime/plan.ts",
      "src/targets/runtime/portable_plan.ts",
      "src/targets/runtime/provenance.ts",
      "src/targets/runtime/public_diagnostic_materializer.ts",
      "src/targets/runtime/public_field_materializer.ts",
      "src/targets/runtime/public_lex_diagnostic_materializer.ts",
      "src/targets/runtime/public_lex_result_materializer.ts",
      "src/targets/runtime/public_parse_result_materializer.ts",
      "src/targets/runtime/public_rule_node_materializer.ts",
      "src/targets/runtime/public_source_text.ts",
      "src/targets/runtime/public_token_materializer.ts",
      "src/targets/runtime/wasm_abi.ts",
      "src/targets/runtime/wasm_core_runtime.ts",
      "src/compiler/runtime_plan/bnf.ts",
      "src/compiler/runtime_plan/lr1.ts",
      "src/compiler/runtime_plan/syntax_emit.ts",
      "src/targets/wasm/module_emit.ts",
      "src/targets/wasm/plan.ts"
    ]
  },
  "fmt": {
    "exclude": [
      "examples/brainfuck/generated",
      "examples/feature-tour/generated",
      "examples/funcfuck/generated",
      "examples/thunkwasm/generated",
      "src/runtime_language/SPEC.md"
    ]
  },
  "lint": {
    "include": [
      "src",
      "scripts"
    ]
  },
  "tasks": {
    "bootstrap": "deno run --allow-read --allow-write scripts/bootstrap_check.ts --write",
    "bootstrap:check": "deno run --allow-read --allow-write --allow-run scripts/bootstrap_check.ts",
    "test": "deno test --allow-read --allow-write --allow-run tests/wasm_test.ts tests/wasm_frontend_scaffold_test.ts",
    "test:wasm-scaffold": "deno test --allow-read --allow-write --allow-run tests/wasm_frontend_scaffold_test.ts",
    "test:brl-conformance": "deno test --allow-read --allow-write --allow-run tests/runtime_language_conformance_test.ts tests/runtime_language_frontend_test.ts tests/runtime_language_wasm_test.ts",
    "test:fuzz": "deno run --allow-read --allow-write scripts/fuzz_v2.ts",
    "check": "deno check src/mod.ts src/api.ts src/cli.ts src/targets/wasm/plan.ts src/wasm_frontend/research.ts scripts/wasm_frontend_probe.ts tests/helpers.ts tests/wasm_test.ts tests/wasm_frontend_scaffold_test.ts",
    "bench:runtime": "deno run --allow-read --allow-write scripts/runtime_bench.ts --budget size-budgets.json",
    "inspect-plan": "deno run --allow-read scripts/inspect_plan.ts",
    "size:report": "deno run --allow-read --allow-write scripts/size_report.ts",
    "size:check": "deno run --allow-read scripts/size_report.ts --budget size-budgets.json",
    "wasm:frontend-probe": "deno run --allow-run scripts/wasm_frontend_probe.ts",
    "publish:dry-run": "deno publish --dry-run --allow-dirty"
  }
}
