const release: string = "2026.06";
let retries: number = 3;
let threshold: number = 95%;
let image: string = "registry/tools/baba";
config service {
  owner: "tools";
  replicas: 4;
  enabled: true;
  pattern: /api-.+/;
}
pipeline checks {
  stage prepare {
    step deps: install(name = "deps");
    step lint: run_lint(strict = true);
    step format: test(kind = "fmt", retries = 1);
  }
  stage verify requires [prepare] {
    step unit: test(kind = "unit", retries = retries);
    step integration: test(kind = "integration", timeout = 120s);
    step smoke: test(kind = "smoke", timeout = 30s);
  }
  stage package requires [verify] {
    step bundle: build(target = "cli", mode = "release");
    step image: build_image(name = image, tag = release);
    step upload: deploy(target = "staging", version = release);
  }
}
pipeline nightly {
  stage prepare {
    step deps: install(name = "deps");
    step clean: clean_cache(age = 24h);
  }
  stage verify requires [prepare] {
    step fuzz: test(kind = "fuzz", timeout = 1h);
    step benchmark: test(kind = "bench", threshold = threshold);
  }
  stage deploy requires [verify] {
    step canary: deploy(target = "canary", version = release);
    step prod: deploy(target = "prod", version = release);
  }
}
policy protected when retries >= 3 && threshold in [90%, 95%, 99%] {
  action: "require-review";
  expires: 2026-12-31;
}
policy emergency when !enabled || release == "rollback" {
  action: "page";
  retries: 5;
}
route api/v1/users to users method GET auth session cache 10s;
route api/v1/builds to builds method POST auth token cache 1m;
route api/v1/releases to releases method PUT auth token cache 1m;
route api/v1/search to search method GET auth session cache 5s;
route internal/jobs to worker method PATCH auth token cache 30s;
