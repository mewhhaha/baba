{
  "version": 2,
  "gpuFrontend": {
    "version": 3,
    "root": "module",
    "islands": [
      { "rule": "module", "boundary": { "kind": "root" } },
      {
        "rule": "definition",
        "boundary": { "kind": "terminated", "terminal": ";" }
      },
      {
        "rule": "emit",
        "boundary": { "kind": "terminated", "terminal": ";" }
      },
      {
        "rule": "group",
        "boundary": { "kind": "paired", "open": "(", "close": ")" }
      },
      {
        "rule": "fanout",
        "boundary": {
          "kind": "separated",
          "open": "[",
          "close": "]",
          "separator": ","
        }
      },
      {
        "rule": "repeat",
        "boundary": { "kind": "terminated", "terminal": ")" }
      },
      { "rule": "reference", "boundary": { "kind": "root" } }
    ],
    "semantics": {
      "rules": {
        "module": { "opcode": "module" },
        "definition": {
          "opcode": "define",
          "fields": { "name": "binder", "body": "value" }
        },
        "reference": {
          "opcode": "reference",
          "fields": { "name": "name" }
        },
        "repeat": {
          "opcode": "repeat-limit",
          "fields": { "count": "count", "body": "value" }
        }
      },
      "primitives": {
        "id": "identity",
        "inc": "increment",
        "dec": "decrement",
        "double": "double",
        "square": "square",
        "neg": "negate",
        "sum": "sum",
        "product": "product",
        "first": "first",
        "last": "last",
        "add": "add",
        "mul": "multiply",
        "take": "take",
        "drop": "drop"
      },
      "operators": { ">>": "compose" },
      "scopes": ["module"],
      "namespaces": ["function"],
      "binders": ["definition"],
      "references": ["reference"]
    }
  },
  "queries": {
    "highlights": {
      "entries": [
        { "literal": "def", "capture": "keyword" },
        { "literal": "emit", "capture": "keyword" },
        { "literal": "repeat", "capture": "function.builtin" },
        { "node": "INTEGER", "capture": "number" },
        { "node": "id", "capture": "function.builtin" },
        { "node": "inc", "capture": "function.builtin" },
        { "node": "dec", "capture": "function.builtin" },
        { "node": "double", "capture": "function.builtin" },
        { "node": "square", "capture": "function.builtin" },
        { "node": "neg", "capture": "function.builtin" },
        { "node": "sum", "capture": "function.builtin" },
        { "node": "product", "capture": "function.builtin" },
        { "node": "first", "capture": "function.builtin" },
        { "node": "last", "capture": "function.builtin" },
        { "node": "add", "capture": "function.builtin" },
        { "node": "mul", "capture": "function.builtin" },
        { "node": "take", "capture": "function.builtin" },
        { "node": "drop", "capture": "function.builtin" }
      ]
    },
    "rainbows": {
      "scopes": ["group", "fanout", "repeat", "stream"],
      "brackets": ["(", ")", "[", "]"]
    }
  }
}
